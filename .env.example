# Personal baseline used by the estimator and dashboard
PTTAX_EMPLOYMENT_MONTHLY_GROSS_SALARY=3000
PTTAX_EMPLOYMENT_PAYMENTS_PER_YEAR=14
PTTAX_SAVINGS_POOL_RATE=0.25
# exempt_article_53 | quarterly
PTTAX_VAT_REGIME=quarterly

# Strings shown in the Fatura-Recibo helper — confirm them with your accountant
PTTAX_CLIENT_NAME="US Client Inc."
PTTAX_CLIENT_ADDRESS="123 Market St, San Francisco, CA 94105"
PTTAX_CLIENT_COUNTRY="Estados Unidos"
PTTAX_CLIENT_TAX_ID=
PTTAX_SERVICE_DESCRIPTION="Prestação de serviços de desenvolvimento de software"
PTTAX_VAT_EXEMPTION_REASON="Artigo 6.º, n.º 7, al. a) do CIVA"
PTTAX_VAT_EXEMPTION_CODE=M99
PTTAX_WITHHOLDING_OPTION="Sem retenção - Não residente sem estabelecimento"

# Nextcloud CalDAV — use an app password (Settings → Security → Devices & sessions)
PTTAX_CALDAV_URL=https://cloud.example.lan/remote.php/dav
PTTAX_CALDAV_CALENDAR_URL=https://cloud.example.lan/remote.php/dav/calendars/USER/pt-tax/
PTTAX_CALDAV_USERNAME=USER
PTTAX_CALDAV_PASSWORD=
PTTAX_CALDAV_VERIFY_TLS=true
PTTAX_VIACTT_REMINDER_INTERVAL_DAYS=30
