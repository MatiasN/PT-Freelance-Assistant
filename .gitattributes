# Normalize all text files to LF in the repo and in the working tree,
# so files copied into Docker images (Linux) never carry CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Captured upstream payloads must keep their original line endings (ECB sends CRLF)
backend/tests/fixtures/*_live.csv -text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite binary

# Lockfiles: generated, collapse in diffs
uv.lock linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
